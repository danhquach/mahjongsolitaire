{
  // Cloudflare Worker that serves the playtest build as static assets (issue #15).
  // The dashboard now creates Workers rather than Pages projects, so deploys go
  // through `wrangler deploy` reading this file — not `wrangler pages deploy`.
  "name": "lantern-tiles",
  "compatibility_date": "2026-08-31",
  // The bundle `ui` builds. CI downloads the tested artifact to this same path
  // before deploying, so local and CI deploys upload identical trees.
  "assets": {
    "directory": "./ui/dist-web/"
  },
  // Issue #118 — the deploy is no longer assets-only: `main` adds a Worker
  // script alongside `assets`. With both set, a request that matches a file
  // under `assets.directory` is served as a static asset; only a request with
  // no matching asset (e.g. `POST /api/feedback`) reaches the script. This is
  // the default routing (`run_worker_first` is intentionally left unset —
  // turning it on globally would send every request, including plain page
  // loads, through the Worker first).
  "main": "worker/index.mjs",
  // Issue #138 — the synced player profile needs a D1 database bound as `DB`.
  // It is deliberately left commented out: `wrangler deploy` fails outright on
  // a binding whose `database_id` does not exist, so uncommenting this before
  // the database is created would take the playtest deploy down. Until then
  // `/api/profile*` answers 503 `not_configured` and the game is unaffected
  // (sync is opt-in and the client treats 503 as "unavailable, try later").
  //
  // One-time setup, then uncomment and paste the id it prints:
  //   wrangler d1 create lantern-tiles
  //   wrangler d1 execute lantern-tiles --remote --file worker/schema.sql
  //
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "lantern-tiles", "database_id": "<id from d1 create>" }
  // ],
  "vars": {
    // Resend's shared test sender (docs/decisions/0019): it can only deliver
    // to the Resend account's own address, so the account must be created
    // with this inbox, or a verified sending domain used instead.
    "FEEDBACK_TO": "dqtgametesting@gmail.com",
    "FEEDBACK_FROM": "Lantern Tiles <onboarding@resend.dev>"
  }
}
