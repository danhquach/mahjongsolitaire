{
  // Cloudflare Worker that serves the playtest build as static assets (issue #15).
  // The dashboard now creates Workers rather than Pages projects, so deploys go
  // through `wrangler deploy` reading this file — not `wrangler pages deploy`.
  "name": "lantern-tiles",
  "compatibility_date": "2026-08-31",
  // The bundle `ui` builds. CI downloads the tested artifact to this same path
  // before deploying, so local and CI deploys upload identical trees.
  "assets": {
    "directory": "./ui/dist-web/"
  },
  // Issue #118 — the deploy is no longer assets-only: `main` adds a Worker
  // script alongside `assets`. With both set, a request that matches a file
  // under `assets.directory` is served as a static asset; only a request with
  // no matching asset (e.g. `POST /api/feedback`) reaches the script. This is
  // the default routing (`run_worker_first` is intentionally left unset —
  // turning it on globally would send every request, including plain page
  // loads, through the Worker first).
  // Issue #187 — the Worker imports core's build (`core/dist`, via
  // worker/replay.mjs) and the ladder/layout JSON under `data/`, all bundled
  // in by wrangler. Run `npm --prefix core run build` before a local
  // `wrangler deploy`; CI's deploy job does the same.
  "main": "worker/index.mjs",
  // Issues #186 and #188 — once a day, delete rate-limit rows whose window
  // opened more than a day ago, runs older than the live week and the one
  // before it, and players who never synced or have gone idle
  // (worker/index.mjs `sweep`). 04:17 UTC: off the hour, and outside the
  // evening peak in every playtest time zone.
  "triggers": {
    "crons": ["17 4 * * *"]
  },
  "vars": {
    // Resend's shared test sender (docs/decisions/0019): it can only deliver
    // to the Resend account's own address, so the account must be created
    // with this inbox, or a verified sending domain used instead.
    "FEEDBACK_TO": "dqtgametesting@gmail.com",
    "FEEDBACK_FROM": "Lantern Tiles <onboarding@resend.dev>"
  },
  // Issues #138 and #70 — the synced player profile and the Daily leaderboard.
  // Created 2026-09-02 with `wrangler d1 create lantern-tiles`, and the schema
  // applied to it in the same pass:
  //   wrangler d1 execute lantern-tiles --remote --file worker/schema.sql
  //   wrangler d1 execute lantern-tiles --remote --file worker/schema-0002-leaderboard.sql
  //
  // Later migrations, each applied the same way before the deploy that reads
  // it (the deploy job checks): schema-0003, schema-0004 (after its deploy —
  // see the file), and schema-0005 (issue #186, the rate limiter's table).
  //
  // A later schema change gets its own numbered file and the same `--remote`
  // run; every file is `IF NOT EXISTS` throughout, so re-applying them all is a
  // safe no-op.
  //
  // `database_id` is an identifier, not a credential — it is useless without
  // account authentication, which is why Cloudflare's config format expects it
  // in a committed file.
  //
  // Two things `wrangler d1 create` wrote here have been changed on purpose:
  //   * the binding is `DB`, not the generated `lantern_tiles`. The Worker
  //     reads `env.DB` (worker/profile.mjs, worker/leaderboard.mjs); under any
  //     other name both features answer 503 `not_configured` forever.
  //   * `"remote": true` is dropped, so `wrangler dev` runs against a *local*
  //     database. Left in, every local experiment would read and write the
  //     live players and leaderboard.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lantern-tiles",
      "database_id": "bbf822cf-134e-4d59-9575-db23832a35f0"
    }
  ]
}
